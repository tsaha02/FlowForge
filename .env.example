# ============================================
# FlowForge Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# --- Root backend/shared env ---
# Keep backend and shared secrets in the repo root .env file.
DATABASE_URL="postgresql://flowforge:flowforge_password@localhost:5432/flowforge?schema=public"

# --- Frontend public env ---
# Put NEXT_PUBLIC_* values in packages/web/.env.local for local development.

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- AI Models (e.g. Groq/OpenAI) ---
GROQ_API_KEY="your-groq-api-key"

# --- Backend Server ---
PORT=4000
NODE_ENV="development"

# --- Encryption Key (for credential vault) ---
ENCRYPTION_KEY="your-32-byte-encryption-key-hex"

# --- Email: Resend API (recommended for cloud deployments — Render, Railway, etc.) ---
# Get a free API key at resend.com. Works on any host — no SMTP port restrictions.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# RESEND_FROM="FlowForge <you@yourdomain.com>"

# --- Email: SMTP fallback (works locally and on VPS that allow port 587/465) ---
# Used only if RESEND_API_KEY is NOT set.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# --- External DB Query (optional) ---
# DB_QUERY_CONNECTION_STRING="postgresql://user:password@host:5432/mydb"
