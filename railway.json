{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd packages/server && npm install && npx prisma generate --schema=./src/prisma/schema.prisma && npm run build",
    "watchPatterns": ["packages/server/**", "package.json"]
  },
  "deploy": {
    "startCommand": "cd packages/server && npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
